# ─────────────────────────────────────────────────────────────
# Pause — environment variables. Copy to .env and fill in.
# Nothing here is required beyond DATABASE_URL to run locally.
# Never commit your real .env file.
# ─────────────────────────────────────────────────────────────

# Postgres (local, Supabase, Neon, RDS…). Supabase: use the "Session pooler"
# connection string and set DATABASE_SSL=require.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/pause
DATABASE_SSL=
DATABASE_POOL_SIZE=10

# Public URL of the site (used in emails, payment redirects and CSRF checks).
APP_URL=http://localhost:3000

# Long random string used to sign test-checkout tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Master admin account — created automatically on first start.
# Change the password immediately after first login (Settings → Security).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=pause_admin

# Community posting requires a verified email. Set to false only for local testing.
REQUIRE_EMAIL_VERIFICATION=true

# ── Email (optional) ── Without a key, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Pause <hello@yourdomain.com>

# ── AI companion (optional) ── Without these, Pip runs in built-in offline mode.
# Any OpenAI-compatible API works: OpenAI, OpenRouter, Groq, Together, a local Ollama…
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=
# Legacy: the original Lovable AI gateway key also works.
LOVABLE_API_KEY=
# Set to true (build-time) to enable spoken conversations for children when transcription is configured.
VITE_VOICE_ENABLED=false

# ── Payments (optional) ── Without keys, a clearly-labelled TEST checkout is used in development.
# Stripe: create two recurring Prices ($3/month, $30/year) and a webhook to /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Razorpay: create two Plans and a webhook to /api/v1/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=
# The test checkout is OFF in production unless this is true. Never enable it on a live site.
PAYMENTS_SANDBOX=

# Build target (default node-server). See https://nitro.build/deploy
NITRO_PRESET=node-server
